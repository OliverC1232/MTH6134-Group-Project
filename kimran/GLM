library(MASS)
library(lme4)
 
players <- read.csv("league_players.csv")
matches <- read.csv("ashford_matches.csv")
players$position <- factor(players$position)
matches$home_away <- factor(matches$home_away, levels = c("Away", "Home"))
 
# injury
inj_full <- glm(injured ~ age + minutes_played + training_load + prev_injuries + bmi + position,
                family = binomial, data = players)
inj <- glm(injured ~ age + training_load + prev_injuries, family = binomial, data = players)
anova(inj, inj_full, test = "LRT")
summary(inj)
exp(cbind(OR = coef(inj), confint(inj)))
plot(inj)
summary(glmer(injured ~ scale(age) + training_load + prev_injuries + (1 | team),
              family = binomial, data = players))
 
# goals scored
gs_int <- glm(goals_scored ~ home_away * opponent_rank, family = poisson, data = matches)
gs <- glm(goals_scored ~ home_away + opponent_rank, family = poisson, data = matches)
anova(gs, gs_int, test = "LRT")
summary(gs)
exp(cbind(RR = coef(gs), confint(gs)))
sum(residuals(gs, type = "pearson")^2) / df.residual(gs)
plot(gs)
summary(update(gs, data = subset(matches, goals_scored < 8)))
 
# home advantage
matches$win <- as.integer(matches$goals_scored > matches$goals_conceded)
fisher.test(table(matches$home_away, matches$win))
win <- glm(win ~ home_away + opponent_rank, family = binomial, data = matches)
summary(win)
exp(cbind(OR = coef(win), confint(win)))
